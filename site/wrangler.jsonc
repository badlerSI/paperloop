{
  // SaaSpocalypse Now: the pitch for Paper Loop, plus two demos that run on your Claude API key.
  // Deploy steps are in README.md.
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Worker's name in the Cloudflare dashboard, or GitHub builds fail.
  "name": "paperloop",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/", "/index.html"]
  },
  "durable_objects": {
    "bindings": [{ "name": "LIMITER", "class_name": "Limiter" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Limiter"] }],
  // The domain has to be on your Cloudflare account before the first deploy (README, step 4).
  "routes": [
    { "pattern": "saaspocalypsenow.ai", "custom_domain": true },
    { "pattern": "www.saaspocalypsenow.ai", "custom_domain": true }
  ],
  // Keep the demos' own one-line cost logs, but not Cloudflare's per-request logs, which hold more
  // about each visitor than the page promises.
  "observability": { "enabled": true, "logs": { "invocation_logs": false } },
  // Deploys from GitHub would otherwise delete variables added in the dashboard.
  "keep_vars": true,
  "vars": {
    // To switch the demos off, add a variable DEMOS = off in the Worker's dashboard settings.
    "WORKSHEET_MODEL": "claude-sonnet-5-5",
    "MARK_MODEL": "claude-sonnet-5-5",
    // The most the demos can spend in a day, across all visitors, in US dollars.
    "DAILY_BUDGET_USD": "5",
    // Demos per visitor (per IP address) per day.
    "WORKSHEETS_PER_VISITOR": "3",
    "MARKS_PER_VISITOR": "8",
    "PAGES_PER_VISITOR": "3",
    // Turnstile's site key is public. Its secret goes in with `wrangler secret put TURNSTILE_SECRET`.
    "TURNSTILE_SITE_KEY": ""
  }
}
